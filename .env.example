# ─── NoSwipeChat – Root Environment Variables ─────────────────────────────────
#
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the real .env file to source control.
#
# These variables are consumed by docker-compose.yml and passed into the
# backend container at runtime.  The frontend is a static build baked into
# the nginx image; runtime values are served via /api/config/public.
#
# Secrets that must be created in GitHub (Actions → Secrets and variables →
# Actions) and in GitHub Codespaces (Settings → Codespaces → Secrets):
#   JWT_SECRET, FACEBOOK_APP_ID, FACEBOOK_APP_SECRET,
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET
# ──────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# Strong random string used to sign JWTs.  Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-use-a-strong-random-value

# ── Facebook OAuth ────────────────────────────────────────────────────────────
# Obtain from https://developers.facebook.com → Your App → Settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Exposed to the frontend build (also served through /api/config/public)
EXPO_PUBLIC_FACEBOOK_APP_ID=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Obtain from https://www.linkedin.com/developers/apps → Auth tab
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Expo / EAS (optional – only needed for mobile builds) ────────────────────
# Find at https://expo.dev → Account → Projects
EAS_PROJECT_ID=
EXPO_SLUG=noswipechat
APP_VERSION=1.0.0

# ── Codespace / tunnel public URL (auto-set by GitHub Codespaces) ─────────────
# Leave blank locally; Codespaces sets this automatically.
# CODESPACE_PUBLIC_URL=https://<name>-8080.preview.app.github.dev
