# ─── NoSwipeChat – Frontend Environment Variables ────────────────────────────
#
# Copy this file to frontend/.env and fill in real values for local
# development of the Expo / React Native web frontend only.
#
# When running the full stack via docker compose, these values are either
# baked into the nginx image at build time or served dynamically through
# /api/config/public – you do not need this file for compose-based runs.
#
# Secrets that must be created in GitHub Codespaces
# (Settings → Codespaces → Secrets): EXPO_PUBLIC_FACEBOOK_APP_ID
# ──────────────────────────────────────────────────────────────────────────────

# ── API & Socket endpoints ────────────────────────────────────────────────────
# Override the default origin-relative URLs for local development.
# When serving the web app through nginx (port 8080), leave these blank –
# the runtime.js helper uses window.location.origin automatically.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# ── Facebook App ID ───────────────────────────────────────────────────────────
# Must match FACEBOOK_APP_ID set in the backend .env / docker-compose secrets.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# ── Expo / EAS (optional – only needed for EAS cloud builds) ─────────────────
EAS_PROJECT_ID=
